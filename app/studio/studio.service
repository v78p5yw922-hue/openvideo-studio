[Unit]
Description=OpenVideo Studio (production platform v2)
After=network.target

[Service]
Type=simple
User=agent
WorkingDirectory=/home/agent/openvideo/video-agent
Environment=HOME=/home/agent
Environment=PATH=/home/agent/openvideo/video-agent/.venv/bin:/usr/lib/wsl/lib:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=STUDIO_DATA=/home/agent/openvideo/studio-data
Environment=STUDIO_ALLOW_RENDER=0
ExecStart=/home/agent/openvideo/video-agent/.venv/bin/uvicorn studio.api.app:app --host 127.0.0.1 --port 8801
Restart=on-failure
RestartSec=3
KillMode=process

[Install]
WantedBy=multi-user.target
